{{ .Getter }}

if {{.InputName}} == "" {
    {{.InputName}} = "0"
}

{{.OutputName}}tmp, ok := {{.EnumValueMap}}[{{.InputName}}]
if !ok {
    // Preserve decimal enum values, including unknown values for application
    // validation, but reject overflow rather than truncating to the enum's int32.
    n, err := strconv.ParseInt({{.InputName}}, 10, 32)
    if err != nil {
        return status.Error(codes.InvalidArgument, "{{.FieldName}} is not a valid enum value")
    }
    {{.OutputName}}tmp = int32(n)
}

{{.OutputName}} := protopack.Message{
        protopack.Tag{Number: {{- .Tag -}}, Type: protopack.VarintType},
		protopack.Varint({{.OutputName}}tmp),
    }
